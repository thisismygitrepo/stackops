#!/usr/bin/env bash


wrap_in_shell_script() {
  # set -euo pipefail
  # ANSI color/style codes
  # BOLD="\033[1m"
  # RESET="\033[0m"
  # GREEN="\033[32m"
  # YELLOW="\033[33m"
  # BLUE="\033[34m"
  # RED="\033[31m"

  local command="$1"
  shift  
  local command_prefix="${command##*/}"
  command_prefix="${command_prefix%.*}"
  command_prefix=$(printf '%s' "$command_prefix" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C sed 's/[^a-z0-9_]/_/g')
  local RANDOM_NAME=$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 12)
  local OP_DIR="$HOME/tmp_results/tmp_scripts/stackops"
  local OP_PROGRAM_PATH="$OP_DIR/${command_prefix}_${RANDOM_NAME}.sh"
  local command_exit_code
  local exit_code
  export OP_PROGRAM_PATH
  # local timestamp=$(date -u +"%Y-%m-%d %H:%M:%SZ")
  # printf "%b\n" "${BOLD}${BLUE}🛠️  stackops — running ${command}${RESET}"
  # printf "%b\n" "${BLUE}Timestamp:${RESET} ${timestamp}"
  # printf "%b\n" "${BLUE}Op program path:${RESET} ${OP_PROGRAM_PATH}"
  # Forward arguments to the command
  "$command" "$@"
  command_exit_code=$?
  if [[ -f "$OP_PROGRAM_PATH" ]]; then
    if [[ "${STACKOPS_VERBOSE:-}" == "1" ]]; then
      printf "%b\n" "🚀 Taking over from python script @ ${OP_PROGRAM_PATH}${RESET}"
    fi
    # printf "%b\n" "${GREEN}▶ Running...${RESET}"
    . "$OP_PROGRAM_PATH"
    exit_code=$?
    # if [[ $exit_code -eq 0 ]]; then
      # printf "%b\n" "${GREEN}✅ '${command}' execution completed.${RESET}"
    # else
      # printf "%b\n" "${YELLOW}⚠️  Program exited with status ${exit_code}${RESET}"
    # fi
  else
    echo " " >&2
    exit_code=$command_exit_code
    # printf "%b\n" "${GREEN}✅ '${command}' execution completed.${RESET}"
  fi
  return "$exit_code"
}

if [[ $# -gt 0 ]]; then
  wrap_in_shell_script "$@"
fi
