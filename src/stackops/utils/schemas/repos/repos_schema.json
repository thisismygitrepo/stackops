{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/thisismygitrepo/stackops/schemas/repos_schema.json",
  "title": "Repository Records Schema",
  "description": "Schema for repository records file containing git repository information",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL of the JSON Schema used for editor completion, help, and validation."
    },
    "version": {
      "type": "string",
      "const": "0.2",
      "description": "Version of the repository records format"
    },
    "repos": {
      "type": "array",
      "description": "List of repository records",
      "items": {
        "$ref": "#/$defs/RepoRecordDict"
      }
    }
  },
  "required": ["version", "repos"],
  "additionalProperties": false,
  "$defs": {
    "RepoSync": {
      "description": "How to synchronize this repository: Git remotes or an encrypted cloud archive.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "git",
              "description": "Synchronize commits through the repository's configured Git remotes."
            }
          },
          "required": ["mode"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "guard",
              "description": "Synchronize an encrypted repository archive through cloud storage."
            },
            "cloud": {
              "type": "string",
              "minLength": 1,
              "description": "Name of the rclone remote that stores the encrypted repository archive."
            },
            "remotePath": {
              "type": "string",
              "minLength": 1,
              "description": "Path to the encrypted repository archive within the selected rclone remote."
            },
            "ignoreGitignore": {
              "type": "boolean",
              "description": "Include Git-ignored files in the archive when true; respect Git ignore rules when false."
            }
          },
          "required": ["mode", "cloud", "remotePath", "ignoreGitignore"],
          "additionalProperties": false
        }
      ]
    },
    "GitVersionInfo": {
      "type": "object",
      "description": "Git version information containing branch and commit details",
      "properties": {
        "branch": {
          "type": "string",
          "description": "Current git branch name"
        },
        "commit": {
          "type": "string",
          "description": "Current git commit hash"
        }
      },
      "required": ["branch", "commit"],
      "additionalProperties": false
    },
    "RepoRemote": {
      "type": "object",
      "description": "Git remote repository configuration",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the remote (e.g., 'origin', 'upstream')"
        },
        "url": {
          "type": "string",
          "description": "URL of the remote repository"
        }
      },
      "required": ["name", "url"],
      "additionalProperties": false
    },
    "RepoRecordDict": {
      "type": "object",
      "description": "Individual repository record containing all relevant git information",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the repository"
        },
        "parentDir": {
          "type": "string",
          "description": "Parent directory path where the repository is located"
        },
        "currentBranch": {
          "type": "string",
          "description": "Currently checked out branch name"
        },
        "remotes": {
          "type": "array",
          "description": "List of configured git remotes",
          "items": {
            "$ref": "#/$defs/RepoRemote"
          }
        },
        "version": {
          "$ref": "#/$defs/GitVersionInfo",
          "description": "Current git version information"
        },
        "isDirty": {
          "type": "boolean",
          "description": "Whether the repository had uncommitted changes when its record was captured."
        },
        "sync": {
          "$ref": "#/$defs/RepoSync",
          "description": "Choose Git remotes or an encrypted cloud archive as the repository's synchronization destination."
        }
      },
      "required": ["name", "parentDir", "currentBranch", "remotes", "version", "isDirty", "sync"],
      "additionalProperties": false
    }
  }
}
