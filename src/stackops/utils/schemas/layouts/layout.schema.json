{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/thisismygitrepo/stackops/refs/heads/main/src/stackops/utils/schemas/layouts/layout.schema.json",
  "title": "Terminal Layouts Schema",
  "version": "0.1.0",
  "description": "Schema for stackops terminal layout YAML files (layout.yaml).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema or config version.",
      "examples": ["0.1"]
    },
    "layouts": {
      "type": "array",
      "description": "List of terminal window layouts.",
      "items": {
        "$ref": "#/definitions/Layout"
      },
      "minItems": 1
    }
  },
  "required": ["version", "layouts"],
  "definitions": {
    "Layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layoutName": {
          "type": "string",
          "description": "Human-friendly layout name."
        },
        "layoutTabs": {
          "type": "array",
          "description": "Tabs to open for this layout.",
          "items": {
            "$ref": "#/definitions/LayoutTab"
          },
          "minItems": 1
        }
      },
      "required": ["layoutName", "layoutTabs"]
    },
    "LayoutTab": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tabName": {
          "type": "string",
          "description": "Tab title shown in terminal (tmux window, tuios workspace, herdr tab)."
        },
        "panes": {
          "type": "array",
          "description": "Panes shown side by side inside the tab (tmux pane, tuios window, herdr pane).",
          "items": {
            "$ref": "#/definitions/LayoutPane"
          },
          "minItems": 1
        },
        "arrangement": {
          "type": "string",
          "enum": ["columns", "rows", "grid"],
          "description": "How the panes share the tab: side by side, stacked, or a balanced grid. Defaults to grid. TUIOS ignores it because its tiler arranges the windows of a workspace."
        },
        "tabWeight": {
          "type": "integer",
          "description": "Optional weight for tab sizing, defaults to 1 if not provided."
        }
      },
      "required": ["tabName", "panes"]
    },
    "LayoutPane": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paneName": {
          "type": "string",
          "description": "Pane title, unique within its tab."
        },
        "startDir": {
          "type": "string",
          "description": "Directory to start the pane in (supports ~ expansion).",
          "examples": ["~/code/example/project"]
        },
        "command": {
          "type": "string",
          "description": "Shell command to execute when the pane opens.",
          "examples": ["fire run -mO liveInf.py main -- --arg1=val1"]
        }
      },
      "required": ["paneName", "startDir", "command"]
    }
  }
}
