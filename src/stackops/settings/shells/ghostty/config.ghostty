# Font and theme
font-family = JetBrains Mono
font-size = 12
theme = wezterm-default

# Window
fullscreen = true
window-decoration = auto
window-padding-x = 7
window-padding-y = 8
window-show-tab-bar = never
background-opacity = 0.98
background-opacity-cells = false
scrollbar = system

# Panes and cursor
focus-follows-mouse = true
unfocused-split-opacity = 0.6
cursor-style = block
cursor-style-blink = false
shell-integration = detect
shell-integration-features = no-cursor
confirm-close-surface = false
macos-option-as-alt = true

# Split creation
keybind = alt+shift++=new_split:right
keybind = alt+shift+_=new_split:down

# Split close and zoom
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+z=toggle_split_zoom

# Split resizing: Ghostty uses pixels; WezTerm uses cells.
keybind = ctrl+shift+arrow_left=resize_split:left,10
keybind = ctrl+shift+arrow_right=resize_split:right,10
keybind = ctrl+shift+arrow_up=resize_split:up,10
keybind = ctrl+shift+arrow_down=resize_split:down,10

# Split navigation
keybind = alt+arrow_left=goto_split:left
keybind = alt+arrow_right=goto_split:right
keybind = alt+arrow_up=goto_split:up
keybind = alt+arrow_down=goto_split:down

# Ghostty cannot select or swap labeled panes, so cycle by creation order.
keybind = ctrl+9=goto_split:previous
keybind = ctrl+0=goto_split:next

config-file = ?auto/theme.ghostty
